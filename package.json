{
  "name": "envorso-fan-recovery-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "build:engine": "tsc -p tsconfig.engine.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run build:engine && node --test dist/test/*.test.js",
    "demo": "npm run build:engine && node dist/src/demo.js",
    "db:migrate": "npm run build:engine && node dist/src/review/cli.js migrate",
    "db:seed": "npm run build:engine && node dist/src/review/cli.js seed",
    "db:reset": "npm run build:engine && node dist/src/review/cli.js reset",
    "test:browser": "npm run build:engine && node scripts/browser-check.mjs",
    "eval:copy": "npm run build:engine && node scripts/copy-evaluation.mjs",
    "eval:copy:live": "npm run build:engine && node --env-file=.env.local scripts/copy-evaluation.mjs --live",
    "install:ci": "npm install --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "next": "16.4.6",
    "openai": "7.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  }
}
